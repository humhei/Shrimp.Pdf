    <PackageReference Include="itext7" Version="99.99.8" />
    <PackageReference Include="itext7.font-asian" Version="7.2.2" />
    <PackageReference Include="Shrimp.Akkling.Cluster.Intergraction" Version="0.2.112"/>
    <PackageReference Include="Shrimp.FSharp.Plus" Version="5.99.579"/>
    <PackageReference Include="Shrimp.LiteDB" Version="5.99.314"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shrimp.Pdf.Logger\Shrimp.Pdf.Logger.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="5.0.1" />
    <PackageReference Update="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>


</Project>
